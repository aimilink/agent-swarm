# 复制为 .env 后，需要由 shell/source 或 systemd EnvironmentFile 加载；
# Python 进程不会自动读取 .env。

# shared：团队与原生单 Agent 共用同一 Profile 数据；isolated：使用隔离目录
HERMES_CONTROL_MODE=shared

# Hermes CLI 命令；systemd 找不到 hermes 时填写绝对路径
HERMES_CLI=hermes

# 可选：Hermes profiles 根目录。shared 模式建议不设置，自动使用当前用户 ~/.hermes。
# systemd EnvironmentFile 不展开 ~，如需设置必须填写绝对路径。
# HERMES_HOME=/home/your-user/.hermes

# 可选：每个 Profile 的团队工作区根目录
# AGENT_TEAM_WORKSPACE_ROOT=/home/your-user/agent_team

# 数据库连接串（默认 SQLite，文件位于 data/agent-swarm.db）
# DATABASE_URL=sqlite:///data/agent-swarm.db

# Agent 通过 MCP 连回中枢的地址
HERMES_AGENTS_MCP_URL=http://127.0.0.1:5050/mcp/

# HTTP 服务端口
HOST=127.0.0.1
PORT=5050

# Web 登录：首次使用 admin / agentswarm，登录后必须修改密码。
# 可在首次启动前覆盖默认账号与默认密码；初始化后密码以数据库中的哈希为准。
# AGENT_TEAM_DEFAULT_USERNAME=admin
# AGENT_TEAM_DEFAULT_PASSWORD=agentswarm
# Cookie 签名密钥；不设置时自动生成 data/.session-secret。
# AGENT_TEAM_SESSION_SECRET=replace-with-a-long-random-secret
# 项目工作区 Linux 终端 Shell。
# AGENT_TEAM_WORKSPACE_SHELL=/bin/bash

# API Bearer Token；用于非浏览器集成，浏览器登录会话无需填写。
# AGENT_TEAM_API_TOKEN=replace-with-a-long-random-token

# 调试模式（仅切换日志级别，run.py 不启用自动 reload）
FLASK_DEBUG=0

# 启动时自动拉起所有已就绪 Agent
AUTO_START_AGENTS=1

# Kanban
KANBAN_BOARD=agent-swarm
KANBAN_POLL_INTERVAL=2
KANBAN_DEFAULT_WORKSPACE=scratch
KANBAN_AUTO_DISPATCH=0

# 项目资料和产物根目录；默认使用本仓库 workspace/projects
# PROJECTS_ROOT=/path/to/shared-projects
