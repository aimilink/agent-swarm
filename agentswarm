#!/usr/bin/env bash
# AgentSwarm service manager.
set -euo pipefail

# --- hostile-env guard -------------------------------------------------------
# Agent-framework shells can preset PORT (e.g. Hermes gateway port 8648) which
# would override AgentSwarm's own port defaults and break start/restart.
# Drop it early; explicit overrides still work via `PORT=5050 agentswarm restart`.
if [[ -z "${AGENTSWARM_KEEP_ENV:-}" ]]; then
  unset PORT || true
fi

resolve_script_dir() {
  local source_path="${BASH_SOURCE[0]}"
  local source_dir
  local link_target
  while [[ -L "$source_path" ]]; do
    source_dir="$(cd -P -- "$(dirname -- "$source_path")" && pwd)"
    link_target="$(readlink -- "$source_path")"
    if [[ "$link_target" == /* ]]; then
      source_path="$link_target"
    else
      source_path="$source_dir/$link_target"
    fi
  done
  cd -P -- "$(dirname -- "$source_path")" && pwd
}

service_home="${AGENTSWARM_HOME:-${AGENTWEAVE_HOME:-}}"
if [[ -n "$service_home" ]]; then
  APP="$(cd -P -- "$service_home" && pwd)"
else
  APP="$(resolve_script_dir)"
fi
RUN_DIR="${AGENTSWARM_RUN_DIR:-${AGENTWEAVE_RUN_DIR:-$APP/.run}}"
PID_FILE="$RUN_DIR/agentswarm.pid"
LEGACY_PID_FILE="$RUN_DIR/agentweave.pid"
LOG_FILE="${AGENTSWARM_LOG_FILE:-${AGENTWEAVE_LOG_FILE:-$RUN_DIR/agentswarm.log}}"
LOCK_DIR="$RUN_DIR/control.lock"

if [[ ! -e "$PID_FILE" && -f "$LEGACY_PID_FILE" ]]; then
  if ! mv "$LEGACY_PID_FILE" "$PID_FILE" 2>/dev/null; then
    PID_FILE="$LEGACY_PID_FILE"
  fi
fi

usage() {
  echo "Usage: agentswarm {start|stop|status|restart}"
}

fail() {
  echo "AgentSwarm: $*" >&2
  exit 1
}

load_env() {
  if [[ -f "$APP/.env" ]]; then
    set -a
    # shellcheck disable=SC1091
    source "$APP/.env"
    set +a
  fi
  export APP_DIR="$APP"
}

read_pid() {
  [[ -f "$PID_FILE" ]] || return 1
  local pid
  pid="$(tr -d "[:space:]" < "$PID_FILE")"
  [[ "$pid" =~ ^[1-9][0-9]*$ ]] || return 1
  printf "%s" "$pid"
}

is_running() {
  local pid="${1:-}"
  [[ -n "$pid" ]] || return 1
  kill -0 "$pid" 2>/dev/null || return 1
  local state
  state="$(ps -p "$pid" -o stat= 2>/dev/null || true)"
  [[ "$state" != *Z* ]]
}

acquire_lock() {
  mkdir -p "$RUN_DIR"
  local attempt
  for attempt in {1..50}; do
    if mkdir "$LOCK_DIR" 2>/dev/null; then
      trap 'rmdir "$LOCK_DIR" 2>/dev/null || true' EXIT
      return 0
    fi
    sleep 0.1
  done
  fail "another service command is still running"
}

start_service() {
  local pid=""
  pid="$(read_pid || true)"
  if is_running "$pid"; then
    echo "AgentSwarm is already running (PID $pid)."
    return 0
  fi
  rm -f "$PID_FILE"
  [[ -f "$APP/start.sh" ]] || fail "start.sh was not found in $APP"
  [[ -x "$APP/.venv/bin/python" ]] || fail "Python environment was not found at $APP/.venv; install dependencies first"
  load_env
  mkdir -p "$RUN_DIR" "$(dirname -- "$LOG_FILE")"
  (
    cd "$APP"
    nohup bash "$APP/start.sh" >> "$LOG_FILE" 2>&1 &
    printf "%s\n" "$!" > "$PID_FILE.tmp"
    mv -f "$PID_FILE.tmp" "$PID_FILE"
  )
  pid="$(read_pid || true)"
  local attempt
  for attempt in {1..20}; do
    if is_running "$pid"; then
      echo "AgentSwarm started (PID $pid)."
      echo "Log: $LOG_FILE"
      return 0
    fi
    sleep 0.1
  done
  rm -f "$PID_FILE"
  echo "AgentSwarm failed to start. Recent log output:" >&2
  tail -n 20 "$LOG_FILE" >&2 2>/dev/null || true
  return 1
}

stop_service() {
  local pid=""
  pid="$(read_pid || true)"
  # Also catch orphan instances: run.py procs from this APP dir that the pidfile
  # lost track of (e.g. after a manual launch). Otherwise they keep serving an
  # old codebase and the next start dies with "address already in use".
  local orphans=""
  orphans="$(pgrep -f "$APP/.venv/bin/python run.py" 2>/dev/null || true)"
  if ! is_running "$pid"; then
    rm -f "$PID_FILE"
    if [[ -n "$orphans" ]]; then
      echo "AgentSwarm is stopped, but orphan instance(s) found: $orphans — stopping them."
      kill $orphans 2>/dev/null || true
      sleep 2
      kill -KILL $orphans 2>/dev/null || true
    else
      echo "AgentSwarm is stopped."
    fi
    return 0
  fi
  kill "$pid" $orphans 2>/dev/null || true
  local attempt
  for attempt in {1..150}; do
    if ! is_running "$pid"; then
      rm -f "$PID_FILE"
      echo "AgentSwarm stopped."
      return 0
    fi
    sleep 0.1
  done
  echo "AgentSwarm did not stop gracefully; terminating PID $pid." >&2
  kill -KILL "$pid" $orphans 2>/dev/null || true
  rm -f "$PID_FILE"
  echo "AgentSwarm stopped."
}

network_ipv4_addresses() {
  local addresses=""
  if command -v hostname >/dev/null 2>&1; then
    addresses="$(hostname -I 2>/dev/null || true)"
  fi
  if [[ -z "$addresses" ]] && command -v ip >/dev/null 2>&1; then
    addresses="$(ip -o -4 addr show scope global 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | tr '\n' ' ')"
  fi
  local address
  for address in $addresses; do
    if [[ "$address" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]] \
      && [[ "$address" != 127.* ]] \
      && [[ "$address" != 169.254.* ]]; then
      printf "%s\n" "$address"
    fi
  done | awk '!seen[$0]++'
}

print_access_urls() {
  local host="${HOST:-127.0.0.1}"
  local port="${PORT:-5050}"
  local address
  case "$host" in
    0.0.0.0)
      echo "Listen: 0.0.0.0:$port"
      echo "Local URL: http://127.0.0.1:$port/"
      while IFS= read -r address; do
        [[ -n "$address" ]] && echo "Network URL: http://$address:$port/"
      done < <(network_ipv4_addresses)
      ;;
    ::)
      echo "Listen: [::]:$port"
      echo "Local URL: http://[::1]:$port/"
      ;;
    *)
      echo "URL: http://$host:$port/"
      ;;
  esac
}

status_service() {
  local pid=""
  pid="$(read_pid || true)"
  if ! is_running "$pid"; then
    rm -f "$PID_FILE"
    echo "AgentSwarm is stopped."
    return 3
  fi
  load_env
  echo "AgentSwarm is running (PID $pid)."
  print_access_urls
  echo "Log: $LOG_FILE"
}

command_name="${1:-}"
[[ $# -le 1 ]] || { usage >&2; exit 2; }

systemd_unit=""
if command -v systemctl >/dev/null 2>&1; then
  if systemctl --user cat agentswarm.service >/dev/null 2>&1; then
    systemd_unit="agentswarm.service"
  elif systemctl --user cat agentweave.service >/dev/null 2>&1; then
    systemd_unit="agentweave.service"
  fi
fi
if [[ -n "$systemd_unit" ]]; then
  case "$command_name" in
    start|stop|restart)
      exec systemctl --user "$command_name" "$systemd_unit"
      ;;
    status)
      if systemctl --user --no-pager status "$systemd_unit"; then
        load_env
        print_access_urls
        exit 0
      else
        status_code=$?
        exit "$status_code"
      fi
      ;;
  esac
fi

case "$command_name" in
  start)
    acquire_lock
    start_service
    ;;
  stop)
    acquire_lock
    stop_service
    ;;
  status)
    status_service
    ;;
  restart)
    acquire_lock
    stop_service
    start_service
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
