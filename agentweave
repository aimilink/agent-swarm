#!/usr/bin/env bash
# Compatibility entry point for the former AgentWeave command.
set -euo pipefail

resolve_script_dir() {
  local source_path="${BASH_SOURCE[0]}"
  local source_dir
  local link_target
  while [[ -L "$source_path" ]]; do
    source_dir="$(cd -P -- "$(dirname -- "$source_path")" && pwd)"
    link_target="$(readlink -- "$source_path")"
    if [[ "$link_target" == /* ]]; then
      source_path="$link_target"
    else
      source_path="$source_dir/$link_target"
    fi
  done
  cd -P -- "$(dirname -- "$source_path")" && pwd
}

script_dir="$(resolve_script_dir)"
echo "agentweave has been renamed to agentswarm; forwarding command." >&2
exec "$script_dir/agentswarm" "$@"
